# ── LLM ────────────────────────────────────
LLM_MODEL_NAME=qwen2.5:7b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# ── 统一大模型适配器（主链路云端,降级顺序 dashscope → deepseek → qianfan → ollama）──
# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com → API-KEY）
# 空 = 降级链自动跳过该供应商
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QIANFAN_API_KEY=
# 主链路供应商选择（默认 dashscope;全本地调试设 LLM_PROVIDER_PRIMARY=ollama）
LLM_PROVIDER_PRIMARY=dashscope

# ── API ────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Database (MySQL, optional; mock data used if unavailable) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce
DB_CHARSET=utf8mb4

# ── 数据源:京东 JData 公开脱敏数据集(可选,下载渠道见 docs/DATA_COMPLIANCE.md) ──
# auto    = MySQL → TTL缓存 → mock(默认,零改动)
# tianchi = MySQL → TTL缓存 → JData CSV → mock(文件缺失自动回退 mock)
DATA_SOURCE=auto
TIANCHI_DATA_DIR=data/tianchi
TIANCHI_MAX_ACTIONS=1000000
TIANCHI_MAX_USERS=100000

# ── Agent ──────────────────────────────────
FACT_CHECK_MODE=relaxed
PREPROCESS_ENABLED=true
MAX_REFLECTION_ROUNDS=2

# ── Skill(Skill engineering)────────────────
# SKILLS_DEFINITIONS_DIR=skills/definitions   # SKILL.md 声明式定义目录
# SKILL_SELECT_ENABLED=true                   # 命中式 Skill 选择 + 渐进式披露
# SKILL_SELECT_TOP_N=3                        # 每次对话最多披露的 Skill 指令数

# ── Watcher ────────────────────────────────
WATCHER_ENABLED=true
POLL_INTERVAL_SECONDS=300

# ── 自动周报(每周一生成,错过自动补做)──
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_HOUR=9

# ── Flywheel ───────────────────────────────
FLYWHEEL_ENABLED=true
FLYWHEEL_VECTOR_BACKEND=milvus

# ── CORS ───────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:7860"]

# ── Logging ────────────────────────────────
LOG_LEVEL=INFO
