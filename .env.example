# ── LLM ────────────────────────────────────
LLM_MODEL_NAME=qwen2.5:7b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# ── API ────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Database (MySQL, optional; mock data used if unavailable) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce
DB_CHARSET=utf8mb4

# ── Agent ──────────────────────────────────
FACT_CHECK_MODE=relaxed
PREPROCESS_ENABLED=true
MAX_REFLECTION_ROUNDS=2

# ── Watcher ────────────────────────────────
WATCHER_ENABLED=true
POLL_INTERVAL_SECONDS=300

# ── Flywheel ───────────────────────────────
FLYWHEEL_ENABLED=true
FLYWHEEL_VECTOR_BACKEND=milvus

# ── CORS ───────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:7860"]

# ── Logging ────────────────────────────────
LOG_LEVEL=INFO
